#!/usr/bin/env bash

set -euo pipefail

WORKTREE_DIRECTORY_SUFFIX='.worktrees'

die() {
    printf 'wt: %s\n' "$*" >&2
    exit 1
}

require_fzf() {
    command -v fzf >/dev/null || die 'fzf is required for interactive selection'
}

repository_root() {
    git rev-parse --show-toplevel 2>/dev/null || die 'run this command from a Git repository or worktree'
}

primary_worktree() {
    local record

    while IFS= read -r -d '' record; do
        case "$record" in
            'worktree '*)
                printf '%s\n' "${record#worktree }"
                return
                ;;
        esac
    done < <(git worktree list --porcelain -z)

    die 'could not determine the primary worktree'
}

worktree_directory() {
    local primary
    primary="$(primary_worktree)"
    printf '%s/%s%s\n' "$(dirname "$primary")" "$(basename "$primary")" "$WORKTREE_DIRECTORY_SUFFIX"
}

branch_directory_name() {
    printf '%s\n' "${1//\//-}"
}

worktree_records() {
    local record path='' branch='(detached)'

    while IFS= read -r -d '' record; do
        case "$record" in
            'worktree '*)
                path="${record#worktree }"
                branch='(detached)'
                ;;
            'branch refs/heads/'*)
                branch="${record#branch refs/heads/}"
                ;;
            '')
                if [[ -n "$path" ]]; then
                    printf '%s\0%s\0' "$path" "$branch"
                    path=''
                fi
                ;;
        esac
    done < <(git worktree list --porcelain -z)

    if [[ -n "$path" ]]; then
        printf '%s\0%s\0' "$path" "$branch"
    fi
}

worktree_branches() {
    local path branch

    while IFS= read -r -d '' path && IFS= read -r -d '' branch; do
        printf '%s\n' "$branch"
    done < <(worktree_records)
}

worktree_choices() {
    local excluded_path="${1:-}" path branch

    while IFS= read -r -d '' path && IFS= read -r -d '' branch; do
        [[ "$path" != "$excluded_path" ]] || continue
        printf '%s\t%s\0' "$branch" "$path"
    done < <(worktree_records)
}

worktree_branch() {
    local requested="$1" path branch

    while IFS= read -r -d '' path && IFS= read -r -d '' branch; do
        if [[ "$path" == "$requested" ]]; then
            printf '%s\n' "$branch"
            return
        fi
    done < <(worktree_records)

    return 1
}

remote_branches() {
    git for-each-ref --format='%(refname:short)' refs/remotes |
        grep -v '/HEAD$' || true
}

base_branch_choices() {
    local ref current

    while IFS= read -r ref; do
        printf '%s\t%s\n' "$ref" "$ref"
    done < <(git for-each-ref --format='%(refname:short)' refs/remotes refs/heads | grep -E '(^|/)(main|master)$' || true)

    current="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD)"
    printf 'current: %s\tHEAD\n' "$current"
}

choose_base_branch() {
    local choice
    require_fzf

    choice="$(base_branch_choices | fzf --delimiter=$'\t' --with-nth=1 --prompt='base branch> ' --height=40%)" || return
    printf '%s\n' "${choice#*$'\t'}"
}

new_branch_name() {
    local requested="$1" prefix

    if [[ "$requested" == */* ]]; then
        printf '%s\n' "$requested"
    elif [[ -n "${GIT_WORKTREE_PREFIX:-}" ]]; then
        prefix="${GIT_WORKTREE_PREFIX%/}"
        printf '%s/%s\n' "$prefix" "$requested"
    else
        printf '%s\n' "$requested"
    fi
}

target_path_for_branch() {
    printf '%s/%s\n' "$(worktree_directory)" "$(branch_directory_name "$1")"
}

add_new_branch() {
    local requested="$1" branch target base
    [[ -n "$requested" ]] || die 'a branch name is required'

    branch="$(new_branch_name "$requested")"
    target="$(target_path_for_branch "$branch")"
    [[ ! -e "$target" ]] || die "worktree path already exists: $target"

    mkdir -p "$(dirname "$target")"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$target" "$branch"
    else
        base="$(choose_base_branch)" || return
        git worktree add -b "$branch" "$target" "$base"
    fi
}

add_remote_branch() {
    local remote_ref="$1" branch target upstream
    branch="${remote_ref#*/}"
    target="$(target_path_for_branch "$branch")"
    [[ ! -e "$target" ]] || die "worktree path already exists: $target"

    if git show-ref --verify --quiet "refs/heads/$branch"; then
        upstream="$(git for-each-ref --format='%(upstream:short)' "refs/heads/$branch")"
        [[ "$upstream" == "$remote_ref" ]] || die "local branch '$branch' tracks '${upstream:-no remote}', not '$remote_ref'"
        git worktree add "$target" "$branch"
    else
        mkdir -p "$(dirname "$target")"
        git worktree add --track -b "$branch" "$target" "$remote_ref"
    fi
}

choose_remote_branch() {
    require_fzf
    remote_branches | fzf --prompt='remote branch> ' --height=40%
}

interactive_add() {
    local output query selected
    require_fzf

    output="$(
        {
            printf '[new branch]\n'
            remote_branches
        } | fzf --phony --print-query --prompt='branch or remote> ' --height=40% \
            --header='Type a new branch name, or select a remote branch'
    )" || return 1

    query="${output%%$'\n'*}"
    selected=''
    if [[ "$output" == *$'\n'* ]]; then
        selected="${output#*$'\n'}"
    fi

    if [[ "$selected" == '[new branch]' || -z "$selected" ]]; then
        add_new_branch "$query"
    else
        add_remote_branch "$selected"
    fi
}

choose_worktree() {
    local query="${1:-}" choice
    require_fzf
    IFS= read -r -d '' choice < <(
        worktree_choices | fzf --read0 --print0 --delimiter=$'\t' --with-nth=1 --prompt='worktree> ' \
            --query "$query" --select-1 --height=40%
    ) || return 1
    printf '%s\n' "${choice#*$'\t'}"
}

remove_worktree_at() {
    local target="$1" primary="$2" branch

    [[ "$target" != "$primary" ]] || die 'refusing to remove the primary worktree'
    branch="$(worktree_branch "$target")" || die "no worktree found at: $target"
    git worktree remove "$target"
    if [[ "$branch" != '(detached)' ]]; then
        git branch -d -- "$branch"
    fi
}

remove_worktree() {
    local requested="${1:-}" primary path branch found=0
    primary="$(primary_worktree)"

    if [[ -n "$requested" ]]; then
        while IFS= read -r -d '' path && IFS= read -r -d '' branch; do
            if [[ "$path" == "$requested" || "$branch" == "$requested" ]]; then
                remove_worktree_at "$path" "$primary"
                found=1
                break
            fi
        done < <(worktree_records)
        (( found )) || die "no worktree found for: $requested"
    else
        require_fzf
        worktree_choices "$primary" | fzf --multi --read0 --print0 --delimiter=$'\t' --with-nth=1 \
            --prompt='remove worktree> ' --height=40% |
            while IFS= read -r -d '' path; do
                remove_worktree_at "${path#*$'\t'}" "$primary"
            done || return 1
    fi

    rmdir "$(worktree_directory)" 2>/dev/null || true
}

usage() {
        cat <<'EOF'
usage: wt <command> [argument]

commands:
    add [branch]       Create a new branch after selecting its base. GIT_WORKTREE_PREFIX is prepended
                                         when set, unless branch already contains a slash.
                                         Without an argument, select a remote branch or type a new name.
    add --remote       Select a remote branch and create a tracking worktree.
    jump [query]       Print a selected worktree path for use with: cd "$(wt jump)"
    ls                 List worktree branches.
    rm [worktree]      Remove a worktree and its local branch; use Tab to select several when omitted.
EOF
}

main() {
    local command="${1:-}" remote_branch
    shift || true

    case "$command" in
        add)
            [[ $# -le 1 ]] || die 'add accepts at most one argument'
            repository_root >/dev/null
            if [[ "${1:-}" == '--remote' ]]; then
                remote_branch="$(choose_remote_branch)" || return
                add_remote_branch "$remote_branch"
            elif [[ -n "${1:-}" ]]; then
                add_new_branch "$1"
            else
                interactive_add
            fi
            ;;
        jump)
            [[ $# -le 1 ]] || die 'jump accepts at most one argument'
            repository_root >/dev/null
            choose_worktree "${1:-}"
            ;;
        ''|ls|list)
            [[ $# -eq 0 ]] || die 'ls does not accept arguments'
            repository_root >/dev/null
            worktree_branches
            ;;
        rm|remove)
            [[ $# -le 1 ]] || die 'rm accepts at most one argument'
            repository_root >/dev/null
            remove_worktree "${1:-}"
            ;;
        -h|--help|help)
            [[ $# -eq 0 ]] || die 'help does not accept arguments'
            usage
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"