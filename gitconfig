[alias]
	cdiff = "diff --cached"
	graph = "log --graph --decorate=full"
	ignore = "!gi() { curl -Ls https://www.gitignore.io/api/$@ ;}; gi"
	w = "worktree"
	wa = "worktree add"
	wl = "worktree list"
	wr = "worktree remove"
[branch]
	sort = -committerdate
[color]
	ui = true
[commit]
	gpgsign = true
	verbose = true
[core]
	autocrlf = input
	editor = vim
	excludesfile = /Users/olleai/dotfiles/git-global-ignore
	hooksPath = /Users/olleai/dotfiles/git-hooks.local
	pager = delta
[diff]
	algorithm = histogram
	colorMoved = default
[fetch]
	prune = true
	prunetags = true
[http]
	postBuffer = 524288000
[init]
	defaultBranch = main
[log]
	date = iso
[merge]
	conflictstyle = diff3
[pretty]
	fixes = Fixes: %h (\"%s\")
[rebase]
	autosquash = true
	autostash = true
[rerere]
	enabled = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = current
[tag]
	sort = taggerdate
[user]
	email = olle+git@iix.se
	name = Olle Aid Kvarnström
	signingkey = EB1DA6F04FA5514C
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[include]
    path = ~/.gitconfig-override