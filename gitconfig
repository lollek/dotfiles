[alias]
	append = "commit --amend --no-edit"
	cdiff = "diff --cached"
	ignore = "!gi() { curl -Ls https://www.gitignore.io/api/$@ ;}; gi"
	graph = "log --graph --decorate=full"
[branch]
	sort = -committerdate
[color]
	ui = true
[commit]
	gpgsign = true
	verbose = true
	template = /Users/olleai/.gitmessage
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = delta
[diff]
	algorithm = histogram
	colorMoved = default
[fetch]
	prune = true
	prunetags = true
[http]
	postBuffer = 524288000
[init]
	defaultBranch = main
[log]
	date = iso
[merge]
	conflictstyle = diff3
[pretty]
	fixes = Fixes: %h (\"%s\")
[rebase]
	autosquash = true
	autostash = true
[rerere]
	enabled = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = current
[tag]
	sort = taggerdate
[user]
	email = olleai@axis.com
	name = Olle Aid Kvarnström
	signingkey = B2E20318
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
