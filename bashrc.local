## Work
axz() {
    fzf \
	--bind "start:reload:gh search repos --owner axteams-one --limit 1000 $1" \
	--bind "enter:become:gh browse -R {1}"
}

kcz() {
    local opener
    opener='kubectl config use-context {1}
	    if ! aws sts get-caller-identity --profile {1} &>/dev/null; then
		aws sso login --profile {1}
	    fi'
    fzf \
	--query "$1" \
	--height 10 \
	--bind "start:reload:kubectl config get-contexts -o name" \
	--bind "enter:become:$opener" \
	--bind "change:unbind:one" \
	--bind "one:become:$opener"
}

source "$HOME/.cargo/env"
source "$HOME/.rover/env"

load-b() { source "$HOME/github/bridge/acs-bridge/scripts/alias.zsh" }
load-ts() { source "$HOME/github/sp-tag-service/scripts/alias.zsh" }
load-vade() { source "$HOME/github/lkp-vms-api/proxy/companion/scripts/alias.zsh" }
load-varo() { source "$HOME/github/lkp-vms-api/router/scripts/alias.zsh" }
load-vs() { source "$HOME/github/lkp-vms-api-schema/scripts/alias.zsh" }

wtz() {
	local destination
	destination="$(wt jump "$@")" && cd "$destination"
}